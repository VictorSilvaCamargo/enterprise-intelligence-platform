# ==============================================================================
# Enterprise Intelligence Platform — Environment Template
# Copy this file to `.env` for local development. Never commit `.env` to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME=Enterprise Intelligence Platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Backend API
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# PostgreSQL
# For Docker Compose use POSTGRES_HOST=postgres; for host execution use localhost.
# ------------------------------------------------------------------------------
POSTGRES_USER=eip_user
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_DB=eip_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=3.0

# ------------------------------------------------------------------------------
# Redis
# For Docker Compose use REDIS_HOST=redis; for host execution use localhost.
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=3.0

# ------------------------------------------------------------------------------
# Frontend (Vite build-time / dev-server variables)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Enterprise Intelligence Platform
VITE_HEALTH_POLL_INTERVAL_MS=30000
